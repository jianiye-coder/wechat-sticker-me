{
  "styles": {
    "chibi": {
      "name": "软萌Q版",
      "prompt": "大头小身、柔和暖色、自然深色眼睛、干净线条和轻柔阴影；保留参考人物的辨识特征，不把所有人物变成同一张动漫脸。"
    },
    "comic": {
      "name": "夸张漫画",
      "prompt": "粗细有变化的漫画线条、明显眉眼嘴变化、夸张手势和运动线；同一人物的脸型、发型及服装始终一致。"
    },
    "minimal": {
      "name": "极简冷脸",
      "prompt": "极简几何成人漫画，狭长头型、横线眼、直嘴、细长身材，灰绿与暗赭色平涂，大量留白，简洁小号文字。无腮红、爱心、星星、大眼睛、白色贴纸边和立体阴影；保持参考人物的发型轮廓等辨识锚点。"
    },
    "doodle": {
      "name": "手帐涂鸦",
      "prompt": "轻微不规则的手绘线条、柔和铅笔质感、少量彩色涂鸦；主体完整清晰，纹理不变成透明边缘噪点。"
    },
    "clay": {
      "name": "黏土玩偶",
      "prompt": "圆润黏土玩偶、柔和哑光材质、简洁立体造型、柔光；保留人物辨识特征，避免复杂投影影响透明背景。"
    },
    "pixel": {
      "name": "复古像素",
      "prompt": "清晰像素块、有限色板和完整轮廓，以发型、服装和脸部特征保持辨识度；避免过细配字，按整数倍率制作并在最终尺寸检查。"
    },
    "absurd": {
      "name": "低清抓拍反应图",
      "prompt": "真人抓拍感，怼脸特写、仰拍歪头、广角五官挤压拉伸、轻微失焦与压缩颗粒；嫌弃、呆滞、强颜欢笑等微妙表情，少量普通白字直接叠图。保留用户身份特征，允许丑萌不精致。不要漫画融化、灵魂幽灵、乱线爆炸、大眼Q版、美颜棚拍、精致描边或大字标题。"
    },
    "line-person": {
      "name": "简笔小人",
      "prompt": "用少量松弛黑线画全身小人，豆豆眼、短嘴、细长手脚，发型简化成色块或几笔，服装少量点色，大量留白，小号手写字。不要大眼Q版、复杂发丝、柔光阴影或大块描边文字。"
    },
    "elastic-comic": {
      "name": "弹性暴走漫画",
      "prompt": "粗糙有力的黑色笔触、平涂高饱和点色；身体像橡皮可拉长、压扁、扭结，动作轮廓变化明显，五官极简，强调全身动作。保留发型眼镜服装锚点，不画精致大眼半身头像。"
    },
    "photocopy-meme": {
      "name": "黑白职场拼贴",
      "prompt": "原创或用户授权的本人脸部特写作灰阶半调处理，大头拼上粗线条简笔身体，复印纸颗粒和纸边质感，黑白高对比，普通粗黑字白纸条；用疲惫和敷衍的脸与动作反差。不能直接挪用现有熊猫头脸或其他人物素材，不套Q版黄衣模板。"
    }
  },
